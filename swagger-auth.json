    "components": {
        "schemas": {
            "RObject": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "description": "状态码类型",
                        "enum": [
                            "0",
                            "1",
                            "2",
                            "500",
                            "403"
                        ]
                    },
                    "msg": {
                        "type": "string",
                        "description": "消息"
                    },
                    "data": {
                        "type": "object",
                        "description": "数据"
                    }
                },
                "description": "统一http请求返回格式"
            },
            "UserRegister": {
                "required": [
                    "code",
                    "email",
                    "password",
                    "username"
                ],
                "type": "object",
                "properties": {
                    "username": {
                        "maxLength": 20,
                        "minLength": 1,
                        "type": "string",
                        "description": "用户名"
                    },
                    "password": {
                        "maxLength": 32,
                        "minLength": 8,
                        "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{8,}$",
                        "type": "string",
                        "description": "密码"
                    },
                    "email": {
                        "pattern": "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$",
                        "type": "string",
                        "description": "邮箱"
                    },
                    "code": {
                        "pattern": "^\\d+$",
                        "type": "string",
                        "description": "验证码"
                    }
                },
                "description": "用户注册信息"
            },
            "UserLogin": {
                "type": "object",
                "properties": {
