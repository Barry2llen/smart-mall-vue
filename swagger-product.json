    "paths": {
        "/public/product/spu/{spuId}/sku-attrs-mapping": {
            "get": {
                "tags": [
                    "商品接口"
                ],
                "summary": "获取skuId与销售属性值的映射关系（key=attr1Id:attr1Value_attr2Id:attr2Value_...）\n（以此类推，其中attrId先按升序排序再组合）\n（该map的value为另一种属性组合的skuId）",
                "operationId": "getSpuSkuAttrsMapping",
                "parameters": [
                    {
                        "name": "spuId",
                        "in": "path",
                        "description": "Spu主键",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/RMapStringLong"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/public/product/item/{skuId}": {
            "get": {
                "tags": [
                    "商品接口"
                ],
                "summary": "获取商品详情",
                "operationId": "getSkuItem",
                "parameters": [
                    {
                        "name": "skuId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    {
                        "name": "sid",
                        "in": "query",
                        "description": "Sku主键"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/RSkuItemVO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/public/product/category/list": {
            "get": {
                "tags": [
                    "商品接口"
                ],
                "summary": "以树形结构查出所有分类以及子分类",
                "operationId": "list",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/RListCategoryVO"
